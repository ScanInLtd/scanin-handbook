# ScanIn client identity — applies to every repo under ~/dev/clients/scanin (direnv walks up).
# Template + docs: scanin-handbook/docs/DEV-ENV-ISOLATION.md, scanin-handbook/ops/env/scanin.envrc
# No secrets here.
export CLOUDSDK_CONFIG="$HOME/.config/gcloud-scanin"
export REPO_GCP_ACCOUNT="scanin.link@gmail.com"
export REPO_GCP_PROJECT="dataloggerdev"          # production, despite the name
export CLOUDSDK_CORE_PROJECT="$REPO_GCP_PROJECT"
export GOOGLE_CLOUD_PROJECT="$REPO_GCP_PROJECT"
export GOOGLE_CLOUD_QUOTA_PROJECT="$REPO_GCP_PROJECT"
export REPO_PORT_SLOT=20                         # ScanIn block 20–29 (DEV-ENV-ISOLATION.md §8)

# firebase-tools ignores CLOUDSDK_CONFIG — a shim pins --account for `firebase` typed in these folders.
PATH_add "$HOME/dev/clients/scanin/.bin"

source_env_if_exists .envrc.local
