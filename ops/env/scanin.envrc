# ScanIn client identity — applies to every repo under ~/dev/clients/scanin (direnv walks up).
# Template + docs: scanin-handbook/ops/env/scanin.envrc, scanin-handbook/docs/DEV-ENV-ISOLATION.md §11
# No secrets here. Personal overrides go in .envrc.local (SCANIN_* names only).
source_env_if_exists .envrc.local
export SCANIN_GCP_ACCOUNT="${SCANIN_GCP_ACCOUNT:-scanin.link@gmail.com}"
export CLOUDSDK_CONFIG="${SCANIN_CLOUDSDK_CONFIG:-$HOME/.config/gcloud-scanin}"
# Pin ADC too: some Google libs/tools ignore CLOUDSDK_CONFIG and silently use the global ADC.
export GOOGLE_APPLICATION_CREDENTIALS="$CLOUDSDK_CONFIG/application_default_credentials.json"
export CLOUDSDK_CORE_PROJECT="dataloggerdev"          # production, despite the name
export GOOGLE_CLOUD_PROJECT="dataloggerdev"
export GOOGLE_CLOUD_QUOTA_PROJECT="dataloggerdev"
export SCANIN_PORT_SLOT=20                            # ScanIn block 20–29 (DEV-ENV-ISOLATION.md §8)
# firebase-tools ignores both — a shim pins --account for `firebase` typed in these folders.
PATH_add "$HOME/dev/clients/scanin/.bin"
